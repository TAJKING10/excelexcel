      "columns": [
        {"letter": "A", "index": 1, "name": "Jours", "description": "Month identifier (J 1-31, F 1-29, etc.)"},
        {"letter": "B", "index": 2, "name": "Jours impos.", "description": "Taxable days (typically 25)"},
        {"letter": "C", "index": 3, "name": "Stat.", "description": "Status (Empl. for employee)"},
        {"letter": "D", "index": 4, "name": "Classe - %", "description": "Tax class and percentage"},
        {"letter": "E", "index": 5, "name": "Rémun. Base", "description": "Base remuneration"},
        {"letter": "F", "index": 6, "name": "Brut Mensuel", "description": "Monthly gross salary"},
        {"letter": "G", "index": 7, "name": "Cotisable", "description": "Taxable amount for social security (=F)"},
        {"letter": "H", "index": 8, "name": "Maladie", "description": "Health insurance contribution (employee)"},
        {"letter": "I", "index": 9, "name": "Pension", "description": "Pension contribution (employee, 8% of Cotisable)"},
        {"letter": "J", "index": 10, "name": "CI-CO2", "description": "CI-CO2 tax"},
        {"letter": "K", "index": 11, "name": "Déductions", "description": "Other deductions"},
        {"letter": "L", "index": 12, "name": "Imposable", "description": "Taxable income"},
        {"letter": "M", "index": 13, "name": "Impots", "description": "Income tax"},
        {"letter": "N", "index": 14, "name": "CIS", "description": "CIS contribution"},
        {"letter": "O", "index": 15, "name": "CISSM", "description": "CISSM contribution"},
        {"letter": "P", "index": 16, "name": "Salaire Net", "description": "Net salary"}
      ]
    },

    "recapitulation_section": {
      "description": "Right side of the sheet, showing hours breakdown and summary",
      "header_row_25": "Heures | Normal | Suppl. | Congés | Férié extra | Congés familliale (COVID-19) | Maladie | RECAPITULATION ANNEE",
      "header_row_26": "Imposable | Impot | NET (columns H, J, K)",
      "data_rows": "27-38 (January=27, February=28, ..., December=38)",
      "total_row": 39,
      "columns": [
        {"letter": "A", "index": 1, "name": "Month", "description": "Month identifier (J, F, M, etc.)"},
        {"letter": "B", "index": 2, "name": "Normal", "description": "Normal hours worked (typically 173)"},
        {"letter": "C", "index": 3, "name": "Suppl.", "description": "Supplementary hours"},
        {"letter": "D", "index": 4, "name": "Congés", "description": "Leave days"},
        {"letter": "E", "index": 5, "name": "Férié extra", "description": "Extra holidays"},
        {"letter": "F", "index": 6, "name": "Congés familliale", "description": "Family leave (COVID-19)"},
        {"letter": "G", "index": 7, "name": "Maladie", "description": "Sick leave"},
        {"letter": "H", "index": 8, "name": "Imposable", "description": "Taxable income (references L from monthly data)"},
        {"letter": "J", "index": 10, "name": "Impot", "description": "Income tax (references M from monthly data)"},
        {"letter": "K", "index": 11, "name": "NET", "description": "Net salary (references P from monthly data)"}
      ]
    }
  },

  "formulas": {
    "monthly_data_formulas": {
      "G_Cotisable": {
        "formula": "=F{row}",
        "example": "=F10 for January",
        "description": "Copy of Brut Mensuel"
      },
      "H_Maladie": {
        "formula": "=71.99+6.43",
        "result": 78.42,
        "description": "Employee health insurance contribution (fixed sum)",
        "note": "This value varies by employee - appears to be employee-specific"
      },
      "K_Deductions": {
        "formula": "=33+460",
        "result": 493,
        "description": "Sum of various deductions",
        "note": "Changes for different tax classes (e.g., just 33 for class 2 in Nov/Dec)"
      }
    },

    "annual_totals_row_22": {
      "description": "Sum all months (rows 10-21) for each column",
      "formula_pattern": "=SUM(E10:E21)",
      "columns_with_totals": ["E", "F", "G", "H", "I", "J", "K", "L", "M", "N", "O", "P"]
    },

    "recapitulation_formulas": {
      "monthly_references": {
        "H_Imposable": {
          "formula": "=L{monthly_row}",
          "example": "=L10 for January (row 27)",
          "description": "References Imposable from monthly data"
        },
        "J_Impot": {
          "formula": "=M{monthly_row}",
          "example": "=M10 for January (row 27)",
          "description": "References Impots from monthly data"
        },
        "K_NET": {
          "formula": "=P{monthly_row}",
          "example": "=P10 for January (row 27)",
          "description": "References Salaire Net from monthly data"
        }
      },
      "annual_total_row_39": {
        "description": "Sum all months (rows 27-38) for recapitulation columns",
        "formula_pattern": "=SUM(B27:B38)",
        "columns_with_totals": ["B", "C", "D", "E", "F", "G", "H", "J", "K"]
      }
    }
  },

  "summary_sheets": {
    "salaire_globale_maladie": {
      "name": "Salaire globale +  Maladie",
      "purpose": "Aggregate all employees' monthly payroll data",
      "structure": "Rows 10-21 for months, Row 22 for annual total",
      "columns": [
        {"letter": "A", "name": "Mois", "values": ["JAN", "FEV", "MAR", "AVR", "MAI", "JUIN", "JUIL", "AOÛ", "SEP", "OCT", "NOV", "DEC"]},
        {"letter": "B", "name": "Brut Mensuel", "formula": "Sum all employees' F column"},
        {"letter": "C", "name": "Cotisable", "formula": "Sum all employees' G column"},
        {"letter": "D", "name": "Maladie", "formula": "Sum all employees' H column"},
        {"letter": "E", "name": "Pension", "formula": "Sum all employees' I column"},
        {"letter": "H", "name": "Déductions", "formula": "Sum all employees' K column"},
        {"letter": "I", "name": "Imposable", "formula": "Sum all employees' L column"},
        {"letter": "J", "name": "Impôt", "formula": "Sum all employees' M column"},
        {"letter": "K", "name": "Salaire Net", "formula": "Sum all employees' P column"},
        {"letter": "M", "name": "Imposable", "formula": "=I10 (copy)"},
        {"letter": "O", "name": "Impôt", "formula": "=J10 (copy)"},
        {"letter": "P", "name": "Crédits", "formula": "Sum all employees' J+N+O columns (CI-CO2, CIS, CISSM)"}
      ],
      "formula_example_B10": "='Miodrag MILIC'!F10+'BERTHE Alexandra'!F10+'SANDRI Sandro'!F10+'JAUD Jean Paul'!F10+'REBELO MATOS Daniel Filipe'!F10+'BALDE Binta'!F10+'Omigie Evbaguehize Stella'!F10+'BEZGUBOV Tatiana'!F10+'RIFFAUD Jean François '!F10+'BROERING Lucas José '!F10"
    },

    "part_patronales": {
      "name": "Part Patronales",
      "purpose": "Calculate employer social security contributions",
      "structure": "Rows 10-21 for months, Row 22 for annual total",
      "columns": [
        {"letter": "A", "name": "Mois"},
        {"letter": "B", "name": "Coti. Maladie", "formula": "='Salaire globale +  Maladie'!C10"},
        {"letter": "C", "name": "Coti. Pension", "formula": "=B10"},
        {"letter": "D", "name": "Coti. Santé", "formula": "=C10"},
        {"letter": "E", "name": "Coti. Accident", "formula": "=D10"},
        {"letter": "G", "name": "Maladie", "formula": "='Salaire globale +  Maladie'!D10"},
        {"letter": "H", "name": "Pension", "formula": "='Salaire globale +  Maladie'!E10"},
        {"letter": "I", "name": "Santé", "formula": "=D10*0.11/100", "rate": "0.11%"},
        {"letter": "J", "name": "Accident", "formula": "=E10*0.75/100", "rate": "0.75%"},
        {"letter": "K", "name": "Total Mensuel", "formula": "=G10+H10+I10+J10"},
        {"letter": "M", "name": "Total Sécurité Sociale", "formula": "=K10"}
      ]
    }
  },

  "calculation_rates": {
    "employee_contributions": {
      "pension": {
        "rate": "8%",
        "base": "Cotisable (column G)",
        "formula": "I = G * 0.08",
        "example": "2570.935 * 0.08 = 205.67"
      },
      "maladie": {
        "description": "Employee health insurance",
        "note": "Appears to be employee-specific calculation",
        "examples": [
          "71.99 + 6.43 = 78.42 (Miodrag MILIC)",
          "71.99 + 6.43 = 78.42 (BERTHE Alexandra)",
          "414.8 (SANDRI Sandro - different calculation)"
        ]
      }
    },

    "employer_contributions": {
      "sante": {
        "rate": "0.11%",
        "base": "Cotisable",
        "formula": "I10 = D10 * 0.11/100"
      },
      "accident": {
        "rate": "0.75%",
        "base": "Cotisable",
        "formula": "J10 = E10 * 0.75/100"
      }
    },

    "fixed_contributions": {
      "CI-CO2": {
        "values": [0, 14],
        "note": "Varies by employee"
      },
      "CIS": {
        "values": [0, 50],
        "note": "Varies by employee"
      },
      "CISSM": {
        "values": [0, 70, "variable"],
        "note": "Varies by employee, some have variable amounts"
      }
    }
  },

